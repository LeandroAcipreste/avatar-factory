# Domínio público já apontado para o IP da VPS. Não inclua protocolo ou caminho.
AVATAR_FACTORY_HOST=avatar.example.com

# Limite máximo de upload em MB.
AVATAR_FACTORY_MAX_UPLOAD_MB=100

# Adaptador GPU Kaggle experimental. Permanece desativado sem chamadas externas.
KAGGLE_GPU_ENABLED=false
# Preencha somente no ambiente de deploy; nunca versione estes valores.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_REF=
KAGGLE_DATASET_SLUG=
